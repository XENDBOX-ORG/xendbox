# Prisma / database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xendbox

# Auth
# Required — minimum 32 characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Payments (optional in dev)
PAYSTACK_SECRET_KEY=

# Monnify (financial rail — required for virtual accounts / withdrawals)
MONNIFY_API_URL=https://api.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=

# Email (optional in dev)
RESEND_API_KEY=
FROM_EMAIL=Xendbox <onboarding@resend.dev>

# Server
PORT=3001